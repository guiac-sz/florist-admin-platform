PORT=3000

# Segredo que assina os tokens de login (JWT). Gere um valor aleatório e longo:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque_por_um_valor_aleatorio_e_longo"

# Endereço do site (front): usado no CORS e nos links dos e-mails.
