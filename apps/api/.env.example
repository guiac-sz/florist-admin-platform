# E-mails. Em desenvolvimento, o Mailpit do docker-compose recebe tudo
# (caixa de entrada em http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Ateliê Flora <nao-responda@ateliefora.com>"
