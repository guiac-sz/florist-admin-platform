generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String
  isAvailable Boolean  @default(true)
  isVisible   Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@map("products")
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id               Int      @id @default(autoincrement())
  name             String
  email            String   @unique
  phone            String?
  /// Só números. Opcional: usado na nota fiscal e no pagamento.
  cpf              String?
  passwordHash     String
  role             Role     @default(CUSTOMER)
  acceptsMarketing Boolean  @default(false)
  /// Sobe 1 a cada troca de senha: tokens de login com o número antigo
  /// deixam de valer (é assim que "encerramos as outras sessões").
  sessionVersion   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  addresses        Address[]
  passwordResets   PasswordResetToken[]

  @@map("users")
}

/// Links de "Esqueci minha senha". Guardamos só o hash do código (nunca o
/// código em si): quem vê o banco não consegue usar os links.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Endereços de entrega salvos pelo cliente.
model Address {
  id           Int      @id @default(autoincrement())
  userId       Int
  /// Apelido para reconhecer: Casa, Trabalho, Casa da mãe...
  label        String
  /// CEP só com números (8 dígitos)
  zipCode      String
  street       String
  /// Texto, e não número: aceita "s/n" e "120A"
  number       String
  complement   String?
  neighborhood String
  city         String
  /// Sigla do estado: SP, RJ...
  state        String
  /// Ponto de referência para o entregador
  reference    String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // onDelete: Cascade → se a conta for excluída, os endereços vão junto.
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}
